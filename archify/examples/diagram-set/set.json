{
  "schema_version": 1,
  "kind": "archify-diagram-set",
  "id": "service-platform",
  "title": "Service Platform / Hierarchical Drill-down",
  "root_diagram": "system",
  "diagrams": [
    { "id": "system", "type": "architecture", "source": "system.json" },
    { "id": "backend", "type": "architecture", "source": "backend.json" },
    { "id": "auth", "type": "architecture", "source": "auth.json" }
  ],
  "drilldowns": [
    { "from": { "diagram": "system", "node": "backend" }, "to_diagram": "backend" },
    { "from": { "diagram": "backend", "node": "gateway" }, "to_diagram": "auth" }
  ],
  "relations": [
    { "id": "rel-login", "from": { "diagram": "system", "node": "frontend" }, "to": { "diagram": "auth", "node": "verifier" }, "kind": "http", "protocol": "HTTPS", "label": "POST /login", "evidence": { "mode": "authored" } },
    { "id": "rel-orders", "from": { "diagram": "system", "node": "frontend" }, "to": { "diagram": "backend", "node": "orders" }, "kind": "http", "protocol": "HTTPS", "label": "GET /orders", "evidence": { "mode": "authored" } },
    { "id": "rel-upload", "from": { "diagram": "system", "node": "frontend" }, "to": { "diagram": "backend", "node": "upload" }, "kind": "event", "label": "upload event", "evidence": { "mode": "authored" } },
    { "id": "rel-store", "from": { "diagram": "backend", "node": "worker" }, "to": { "diagram": "system", "node": "database" }, "kind": "data-flow", "protocol": "SQL", "label": "persist results", "evidence": { "mode": "authored" } },
    { "id": "rel-auth-orders", "from": { "diagram": "auth", "node": "session" }, "to": { "diagram": "backend", "node": "orders" }, "kind": "http", "label": "authorized request", "evidence": { "mode": "authored" } }
  ],
  "projections": [
    { "diagram": "system", "relation_id": "frontend_to_backend", "derived_from": ["rel-login", "rel-orders", "rel-upload"], "status": "resolved" },
    { "diagram": "system", "relation_id": "backend_to_database", "projectionPolicy": "derived", "kind": "data-flow" },
    { "diagram": "backend", "relation_id": "authenticated_orders", "projectionPolicy": "derived", "kind": "http" }
  ],
  "interfaces": [
    {
      "diagram": "backend", "owner": { "diagram": "system", "node": "backend" },
      "ports": [
        { "id": "incoming-http", "direction": "in", "kind": "http", "targets": ["gateway", "orders"], "side": "left" },
        { "id": "incoming-events", "direction": "in", "kind": "event", "targets": ["upload"], "side": "left" },
        { "id": "outgoing-storage", "direction": "out", "kind": "data-flow", "targets": ["worker"], "side": "right" }
      ]
    }
  ],
  "viewer": { "transition": "frosted-glass", "blur_px": 6, "external_connections": "ports-and-links", "initial_relation_mode": "bundled", "bundle_threshold": 5 }
}
